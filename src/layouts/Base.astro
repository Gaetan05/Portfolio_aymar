---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import Preloader from '../components/Preloader.astro';
import { site } from '../site.config';
import { url } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Show the first-visit preloader (home page only). */
  preloader?: boolean;
  /** Hide the big footer CTA (e.g. on the CV). */
  bareFooter?: boolean;
}

const { title, description = site.intro, image, type = 'website', noindex = false, preloader = false, bareFooter = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.headline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? url('og.png'), Astro.site);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Journal`} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#ebe7dd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0d" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        var d = document.documentElement, t = null;
        d.classList.add('js');
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        // Safety net: never leave content hidden if scripts fail.
        setTimeout(function () { d.classList.add('ready'); }, 3500);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {preloader && <Preloader />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer bare={bareFooter} />
    <Search />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 10000;
    padding: 0.7em 1em;
    background: var(--signal);
    color: var(--signal-ink);
    font-family: var(--f-mono);
    font-size: 0.75rem;
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }
</style>
