---
/** Shared editorial layout for a project, journal entry or hobby. */
import type { MarkdownHeading, ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Cover from '../components/Cover.astro';
import { url, slugify } from '../lib/content';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  back: { href: string; label: string };
  /** Spec sheet shown under the title: [{ k: 'Year', v: '2026' }] */
  specs?: { k: string; v: string }[];
  tags?: string[];
  cover?: ImageMetadata;
  /** Seed/colour for the generative cover when there is no image. */
  art?: { seed: string; accent?: string; pattern?: number } | false;
  headings?: MarkdownHeading[];
  next?: { href: string; title: string; label: string };
  type?: 'website' | 'article';
  icon?: string;
}

const { title, description, eyebrow, back, specs = [], tags = [], cover, art, headings = [], next, type = 'article', icon } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={description} type={type}>
  <div class="progress no-print" data-progress aria-hidden="true"></div>

  <article class="entry">
    <header class="e-head pad">
      <div class="e-top grid12">
        <a class="mono e-back" href={back.href} data-intro>
          <span class="roll"><span data-t={`← ${back.label}`}>← {back.label}</span></span>
        </a>
        <p class="label e-eyebrow" data-intro>{eyebrow}</p>
      </div>
      {icon && <span class="e-icon" data-intro>{icon}</span>}
      <h1 class="display e-title" data-intro="lines">{title}</h1>
      <div class="e-sub grid12">
        <p class="e-desc" data-intro>{description}</p>
        {
          specs.length > 0 && (
            <dl class="e-specs" data-intro>
              {specs.map((s) => (
                <div>
                  <dt class="label">{s.k}</dt>
                  <dd>{s.v}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
      <slot name="actions" />
    </header>

    {
      (cover || art) && (
        <figure class="e-cover" data-unveil>
          <div class="e-cover-in" data-parallax="0.12">
            {cover ? (
              <Image src={cover} alt="" widths={[800, 1400, 2000]} sizes="100vw" />
            ) : (
              art && <Cover seed={art.seed} accent={art.accent} pattern={art.pattern} ratio="21 / 9" />
            )}
          </div>
        </figure>
      )
    }

    <div class="e-body pad grid12">
      <aside class="e-aside no-print">
        {
          toc.length > 1 && (
            <nav class="toc" aria-label="On this page">
              <p class="label">Contents</p>
              <ol>
                {toc.map((h, i) => (
                  <li>
                    <a href={`#${h.slug}`}>
                      <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                      <span class="ulink">{h.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </aside>
      <div class="prose e-prose">
        <slot />
      </div>
    </div>

    {
      tags.length > 0 && (
        <div class="e-tags pad grid12">
          <p class="label">Filed under</p>
          <div class="tags">
            {tags.map((t) => (
              <a class="tag" href={url(`tags/${slugify(t)}`)}>
                #{t}
              </a>
            ))}
          </div>
        </div>
      )
    }

    {
      next && (
        <a class="e-next pad no-print" href={next.href} data-cursor="Next">
          <span class="label">{next.label}</span>
          <span class="display e-next-title">{next.title}</span>
          <span class="e-next-arr display">→</span>
        </a>
      )
    }
  </article>
</Base>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 1000;
  }
  .e-head {
    padding-top: calc(var(--header-h) + clamp(28px, 5vw, 72px));
  }
  .e-top {
    padding-top: 12px;
    border-top: 1px solid var(--rule-strong);
  }
  .e-back {
    grid-column: 1 / span 4;
  }
  .e-eyebrow {
    grid-column: 5 / -1;
  }
  .e-icon {
    display: block;
    font-size: clamp(3rem, 7vw, 6rem);
    margin-top: clamp(24px, 4vw, 56px);
    line-height: 1;
  }
  .e-title {
    font-size: clamp(3rem, 10.5vw, 12rem);
    margin-top: clamp(24px, 4vw, 56px);
    text-wrap: balance;
    hyphens: auto;
    overflow-wrap: anywhere;
  }
  .e-sub {
    margin-top: clamp(28px, 4vw, 56px);
    padding-top: 14px;
    border-top: 1px solid var(--rule-strong);
    row-gap: 24px;
    align-items: start;
  }
  .e-desc {
    grid-column: 1 / span 6;
    font-family: var(--f-serif);
    font-style: italic;
    font-size: clamp(1.5rem, 2.6vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .e-specs {
    grid-column: 8 / -1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px var(--gap);
  }
  .e-specs dd {
    margin-top: 4px;
    font-size: 0.98rem;
  }
  .e-cover {
    margin-top: clamp(40px, 6vw, 96px);
    overflow: hidden;
    height: min(62vw, 86vh);
  }
  .e-cover-in {
    height: 118%;
    margin-top: -9%;
  }
  .e-cover-in :global(.cover),
  .e-cover-in :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: cover;
  }
  .e-body {
    margin-top: clamp(56px, 8vw, 120px);
    align-items: start;
  }
  .e-aside {
    grid-column: 1 / span 3;
    position: sticky;
    top: calc(var(--header-h) + 20px);
  }
  .toc ol {
    margin-top: 12px;
    border-top: 1px solid var(--rule);
  }
  .toc a {
    display: flex;
    gap: 1em;
    padding: 9px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.92rem;
  }
  .toc .mono {
    color: var(--ink-3);
    font-size: 0.7rem;
    padding-top: 0.25em;
  }
  .e-prose {
    grid-column: 4 / span 7;
  }
  .e-prose > :global(p:first-child) {
    display: flow-root;
  }
  .e-prose > :global(p:first-child::first-letter) {
    font-family: var(--f-display);
    font-stretch: 75%;
    font-weight: 800;
    float: left;
    font-size: 5.4em;
    line-height: 0.78;
    padding: 0.06em 0.1em 0 0;
    text-transform: uppercase;
  }
  .e-tags {
    margin-top: clamp(48px, 7vw, 100px);
    padding-top: 14px;
    align-items: baseline;
  }
  .e-tags .label {
    grid-column: 1 / span 3;
    border-top: 1px solid var(--rule-strong);
    padding-top: 12px;
  }
  .e-tags .tags {
    grid-column: 4 / -1;
    border-top: 1px solid var(--rule-strong);
    padding-top: 12px;
  }
  .e-next {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 12px 24px;
    margin-top: clamp(80px, 12vw, 180px);
    padding-block: 18px 0;
    border-top: 1px solid var(--rule-strong);
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .e-next::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--signal);
    z-index: -1;
    transform: translateY(101%);
    transition: transform 0.8s var(--ease-out);
  }
  .e-next:hover::before {
    transform: none;
  }
  .e-next:hover {
    color: var(--signal-ink);
  }
  .e-next .label {
    grid-column: 1 / -1;
    color: inherit;
    opacity: 0.6;
  }
  .e-next-title {
    font-size: clamp(2.8rem, 9vw, 10rem);
    padding-bottom: 0.08em;
  }
  .e-next-arr {
    font-size: clamp(2.8rem, 9vw, 10rem);
    transition: transform 0.8s var(--ease-out);
  }
  .e-next:hover .e-next-arr {
    transform: translateX(0.15em) rotate(-45deg);
  }
  @media (max-width: 900px) {
    .e-desc,
    .e-specs,
    .e-prose {
      grid-column: 1 / -1;
    }
    .e-aside {
      display: none;
    }
    .e-tags .label {
      grid-column: 1 / -1;
    }
    .e-tags .tags {
      grid-column: 1 / -1;
      border-top: 0;
    }
  }
</style>
