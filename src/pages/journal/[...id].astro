---
import { render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';
import { getJournal, url, formatDate, kindLabel, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getJournal();
  return entries.map((e, i) => ({
    params: { id: e.id },
    props: { entry: e, next: entries[i + 1] ?? entries[0] },
  }));
}

const { entry, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const specs = [
  { k: 'Published', v: formatDate(d.date, { year: 'numeric', month: 'long', day: 'numeric' }) },
  { k: 'Reading', v: `${readingTime(entry.body)} min` },
  { k: 'Type', v: kindLabel[d.kind] },
  ...(d.updated ? [{ k: 'Updated', v: formatDate(d.updated) }] : []),
];
---

<Entry
  title={d.title}
  description={d.description}
  eyebrow={`Journal — ${kindLabel[d.kind]}`}
  back={{ href: url('journal'), label: 'Journal' }}
  specs={specs}
  tags={d.tags}
  cover={d.cover}
  art={d.kind === 'essay' ? { seed: d.title, pattern: 0 } : false}
  headings={headings}
  next={next && next.id !== entry.id ? { href: url(`journal/${next.id}`), title: next.data.title, label: 'Keep reading' } : undefined}
>
  <Content />
</Entry>
