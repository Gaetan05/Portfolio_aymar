---
import { render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';
import { getJournal, url, formatDate, kindLabel, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getJournal();
  return entries.map((e, i) => ({
    params: { id: e.id },
    props: { entry: e, prev: entries[i - 1], next: entries[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const meta = [formatDate(d.date, { year: 'numeric', month: 'long', day: 'numeric' }), `${readingTime(entry.body)} min read`];
if (d.updated) meta.push(`Updated ${formatDate(d.updated)}`);
---

<Entry
  title={d.title}
  description={d.description}
  eyebrow={kindLabel[d.kind]}
  back={{ href: url('journal'), label: 'Journal' }}
  meta={meta}
  tags={d.tags}
  cover={d.cover}
  headings={headings}
  prev={prev && { href: url(`journal/${prev.id}`), title: prev.data.title }}
  next={next && { href: url(`journal/${next.id}`), title: next.data.title }}
>
  <Content />
</Entry>
