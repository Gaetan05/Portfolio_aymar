---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getTagIndex, url, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const index = await getTagIndex();
  return [...index].map(([slug, t]) => ({ params: { tag: slug }, props: t }));
}

const { label, items } = Astro.props;
const sorted = [...items].sort((a, b) => (b.date?.valueOf() ?? 0) - (a.date?.valueOf() ?? 0));
---

<Base title={`#${label}`} description={`Everything tagged “${label}”.`}>
  <PageHero index="#" label="Tagged" title={`#${label}`} count={items.length} intro={`Everything in the atlas filed under “${label}”.`}>
    <a class="mono ulink" href={url('tags')}>← All tags</a>
  </PageHero>
  <ol class="pad list">
    {
      sorted.map((i) => (
        <li>
          <a class="row" href={i.href} data-cursor="Open">
            <span class="mono k">{i.kind}</span>
            <span class="t display">{i.title}</span>
            <span class="d">{i.description}</span>
            <span class="mono dt">{i.date ? formatDate(i.date) : ''}</span>
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .list {
    border-top: 1px solid var(--rule-strong);
    margin-inline: var(--pad);
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 10% 1fr 32% 10%;
    gap: var(--gap);
    align-items: baseline;
    padding-block: 20px;
    border-bottom: 1px solid var(--rule);
    transition: background 0.3s;
  }
  .row:hover {
    background: var(--signal);
    color: var(--signal-ink);
  }
  .k,
  .dt {
    opacity: 0.6;
  }
  .t {
    font-size: clamp(1.8rem, 3.4vw, 3.4rem);
  }
  .d {
    opacity: 0.8;
  }
  .dt {
    justify-self: end;
  }
  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr auto;
    }
    .t,
    .d {
      grid-column: 1 / -1;
    }
    .dt {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
