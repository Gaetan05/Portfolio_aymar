---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getTagIndex, url } from '../../lib/content';
const tags = [...(await getTagIndex())].sort((a, b) => b[1].items.length - a[1].items.length || a[0].localeCompare(b[0]));
const max = Math.max(1, ...tags.map(([, t]) => t.items.length));
---

<Base title="Tags" description="Every topic on the site, across projects, notes, hobbies and the shelf.">
  <PageHero index="#" label="Index of topics" title="Tag" italic="s" count={tags.length} intro="Every topic in the atlas — across projects, the journal, hobbies and the shelf. The bigger it is, the more it comes up." />
  <section class="pad cloud">
    {
      tags.map(([slug, t], i) => (
        <a href={url(`tags/${slug}`)} style={`--s:${0.35 + (t.items.length / max) * 0.65}`} class:list={['t', { alt: i % 3 === 1 }]}>
          <span class="t-l">{t.label}</span>
          <sup class="mono">{t.items.length}</sup>
        </a>
      ))
    }
  </section>
</Base>

<style>
  .cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.35em;
    padding-top: 24px;
  }
  .t {
    font-family: var(--f-display);
    font-stretch: 75%;
    font-weight: 750;
    text-transform: uppercase;
    font-size: calc(var(--s) * clamp(3rem, 8vw, 8rem));
    line-height: 0.95;
    letter-spacing: -0.03em;
    transition: color 0.3s;
  }
  .t.alt {
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
  }
  .t:hover .t-l {
    background: var(--signal);
    color: var(--signal-ink);
  }
  .cloud:hover .t:not(:hover) {
    color: var(--ink-3);
  }
  sup {
    font-size: 0.7rem;
    color: var(--ink-3);
    margin-left: 0.2em;
    letter-spacing: 0;
    font-style: normal;
  }
</style>
