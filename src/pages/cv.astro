---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { getExperience, getProjects, formatRange, url } from '../lib/content';

const experience = await getExperience();
const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 4);
const groups = [
  { title: 'Experience', items: experience.filter((e) => e.data.kind === 'work') },
  { title: 'Education', items: experience.filter((e) => e.data.kind === 'education') },
  { title: 'Certifications', items: experience.filter((e) => e.data.kind === 'certification') },
  { title: 'Volunteering', items: experience.filter((e) => e.data.kind === 'volunteer') },
  { title: 'Awards', items: experience.filter((e) => e.data.kind === 'award') },
].filter((g) => g.items.length);
const host = Astro.site ? new URL(url(), Astro.site).href.replace(/^https?:\/\//, '').replace(/\/$/, '') : '';
---

<Base title="CV" description={`Curriculum vitae of ${site.name}.`} bareFooter>
  <div class="toolbar pad no-print">
    <p class="mono">Generated from the same content as the rest of the site — always up to date.</p>
    <button class="pill solid" type="button" onclick="window.print()" data-magnetic>Download PDF <span class="arr">↓</span></button>
  </div>
  <article class="cv">
    <header class="cv-head">
      <h1 class="display">{site.name}</h1>
      <div class="cv-sub">
        <p class="serif headline">{site.headline}</p>
        <ul class="contact mono">
          {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
          {site.location && <li>{site.location}</li>}
          {host && <li><a href={url()}>{host}</a></li>}
          {site.socials.filter((s) => s.url.startsWith('http')).map((s) => <li><a href={s.url}>{s.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></li>)}
        </ul>
      </div>
    </header>

    <section class="blk">
      <h2 class="label">Profile</h2>
      <p class="profile">{site.intro}</p>
    </section>

    {groups.map((g) => (
      <section class="blk">
        <h2 class="label">{g.title}</h2>
        <div>
          {g.items.map((e) => (
            <div class="row">
              <div class="when mono">{formatRange(e.data.start, e.data.end)}</div>
              <div>
                <h3>{e.data.role} <span class="org">— {e.data.org}</span></h3>
                {e.data.location && <p class="loc mono">{e.data.location}</p>}
                {e.data.summary && <p>{e.data.summary}</p>}
                {e.data.highlights.length > 0 && <ul>{e.data.highlights.map((h) => <li>{h}</li>)}</ul>}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    {projects.length > 0 && (
      <section class="blk">
        <h2 class="label">Selected projects</h2>
        <div>
          {projects.map((p) => (
            <div class="row">
              <div class="when mono">{p.data.date.getUTCFullYear()}</div>
              <div>
                <h3>{p.data.title}</h3>
                <p>{p.data.summary}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="blk">
      <h2 class="label">Skills</h2>
      <div>
        {site.skills.map((g) => <p class="sk"><span class="mono">{g.group}</span> {g.items.join(', ')}</p>)}
      </div>
    </section>
    {site.languages.length > 0 && (
      <section class="blk">
        <h2 class="label">Languages</h2>
        <div>{site.languages.map((l) => <p class="sk"><span class="mono">{l.name}</span> {l.level}</p>)}</div>
      </section>
    )}
  </article>
</Base>

<style>
  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: calc(var(--header-h) + 32px);
    color: var(--ink-3);
  }
  .cv {
    width: min(1100px, calc(100% - 2 * var(--pad)));
    margin: 32px auto 80px;
    padding: clamp(24px, 5vw, 72px);
    background: #f7f5ef;
    color: #0f0f0d;
    font-size: 0.95rem;
    line-height: 1.5;
    box-shadow: 0 40px 100px -40px rgb(0 0 0 / 0.4);
  }
  .cv-head {
    padding-bottom: 28px;
    border-bottom: 3px solid #0f0f0d;
  }
  h1 {
    font-size: clamp(3rem, 9vw, 7.5rem);
  }
  .cv-sub {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 16px;
  }
  .headline {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
  }
  .contact {
    text-align: right;
    font-size: 0.7rem;
    line-height: 1.6;
    text-transform: none;
  }
  .blk {
    display: grid;
    grid-template-columns: 22% 1fr;
    gap: 24px;
    padding-block: 24px;
    border-bottom: 1px solid rgb(15 15 13 / 0.15);
  }
  .blk .label {
    color: #75726a;
    padding-top: 4px;
  }
  .profile {
    font-size: 1.2rem;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
  .row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 16px;
    padding-block: 8px;
    break-inside: avoid;
  }
  .row + .row {
    border-top: 1px dashed rgb(15 15 13 / 0.15);
    padding-top: 14px;
  }
  .when {
    font-size: 0.7rem;
    color: #75726a;
    padding-top: 4px;
  }
  h3 {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .org {
    font-weight: 400;
    color: #3b3a36;
  }
  .loc {
    font-size: 0.66rem;
    color: #75726a;
    margin: 2px 0 6px;
  }
  .row p {
    margin-top: 4px;
  }
  .row ul {
    margin-top: 6px;
    display: grid;
    gap: 3px;
  }
  .row li {
    padding-left: 1.2em;
    position: relative;
  }
  .row li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: #75726a;
  }
  .sk {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 16px;
  }
  .sk + .sk {
    margin-top: 6px;
  }
  .sk .mono {
    font-size: 0.7rem;
    color: #75726a;
    padding-top: 3px;
  }
  @media (max-width: 700px) {
    .blk,
    .row,
    .sk {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .contact {
      text-align: left;
    }
  }
  @media print {
    @page {
      margin: 12mm;
    }
    :global(body) {
      background: #fff !important;
    }
    :global(.hdr),
    :global(.ftr),
    :global(.cursor) {
      display: none !important;
    }
    .cv {
      box-shadow: none;
      padding: 0;
      margin: 0;
      max-width: none;
      background: #fff;
      font-size: 9.5pt;
    }
    h1 {
      font-size: 44pt;
    }
  }
</style>
