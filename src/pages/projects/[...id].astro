---
import { render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';
import { getProjects, url, formatDate, statusLabel } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { id: p.id },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content, headings } = await render(project);
const d = project.data;
const specs = [
  { k: 'Year', v: formatDate(d.date, { year: 'numeric', month: 'long' }) },
  { k: 'Status', v: statusLabel[d.status] },
  ...(d.role ? [{ k: 'Role', v: d.role }] : []),
  ...(d.stack.length ? [{ k: 'Stack', v: d.stack.join(', ') }] : []),
  ...(d.updated ? [{ k: 'Updated', v: formatDate(d.updated) }] : []),
];
---

<Entry
  title={d.title}
  description={d.summary}
  eyebrow="Project"
  back={{ href: url('projects'), label: 'All projects' }}
  specs={specs}
  tags={d.tags}
  cover={d.cover}
  art={{ seed: d.title, accent: d.accent }}
  headings={headings}
  next={next && next.id !== project.id ? { href: url(`projects/${next.id}`), title: next.data.title, label: 'Next project' } : undefined}
>
  {
    d.links.length > 0 && (
      <div slot="actions" class="links">
        {d.links.map((l, i) => (
          <a class:list={['pill', { solid: i === 0 }]} href={l.url} target="_blank" rel="noopener" data-magnetic>
            {l.label} <span class="arr">↗</span>
          </a>
        ))}
      </div>
    )
  }
  <Content />
</Entry>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
</style>
