---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getHobbies, url } from '../../lib/content';
const hobbies = await getHobbies();
const TONES = ['var(--signal)', '#c9b8ff', '#ff5b24', '#2d3cff', '#1e3b2f', '#ebe7dd'];
const INK = ['#0f0f0d', '#0f0f0d', '#0f0f0d', '#ebe7dd', '#d4ff3a', '#0f0f0d'];
---

<Base title="Hobbies" description="What I do for the love of it.">
  <PageHero
    index="04"
    label="Off the clock"
    title="For"
    italic="love"
    count={hobbies.length}
    intro="The things I do when nobody’s paying me — and that quietly make me better at the things they do."
  />

  <section class="pad hlist">
    {
      hobbies.map((h, i) => (
        <a class="h" href={url(`hobbies/${h.id}`)} style={`--tone:${TONES[i % TONES.length]};--tone-ink:${INK[i % INK.length]}`} data-cursor="Open">
          <span class="h-n mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="h-title display">{h.data.title}</span>
          <span class="h-icon" aria-hidden="true">
            {h.data.icon}
          </span>
          <span class="h-sum">{h.data.summary}</span>
          <span class="h-since mono">{h.data.since ? `Since ${h.data.since}` : '—'}</span>
        </a>
      ))
    }
  </section>
</Base>

<style>
  .hlist {
    border-top: 1px solid var(--rule-strong);
    margin-inline: var(--pad);
    padding-inline: 0;
  }
  .h {
    position: relative;
    display: grid;
    grid-template-columns: 5% 1fr 30% 10%;
    gap: var(--gap);
    align-items: center;
    padding-block: clamp(18px, 2.4vw, 34px);
    border-bottom: 1px solid var(--rule-strong);
    isolation: isolate;
    overflow: hidden;
  }
  .h::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--tone);
    z-index: -1;
    transform: translateY(101%);
    transition: transform 0.7s var(--ease-out);
  }
  .h:hover::before {
    transform: none;
  }
  .h:hover {
    color: var(--tone-ink);
  }
  .h-title {
    font-size: clamp(2.6rem, 8vw, 8.5rem);
    transition: transform 0.7s var(--ease-out);
  }
  .h:hover .h-title {
    transform: translateX(0.1em);
  }
  .h-icon {
    position: absolute;
    right: 32%;
    top: 50%;
    font-size: clamp(3rem, 8vw, 8rem);
    translate: 0 -50%;
    scale: 0;
    rotate: -30deg;
    transition: scale 0.7s var(--ease-out), rotate 0.7s var(--ease-out);
    pointer-events: none;
  }
  .h:hover .h-icon {
    scale: 1;
    rotate: 8deg;
  }
  .h-sum {
    font-size: 1rem;
    line-height: 1.4;
    opacity: 0.85;
  }
  .h-since {
    justify-self: end;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .h {
      grid-template-columns: auto 1fr;
    }
    .h-title {
      grid-column: 1 / -1;
    }
    .h-sum {
      grid-column: 1 / -1;
    }
    .h-since {
      grid-row: 1;
      grid-column: 2;
    }
    .h-icon {
      scale: 1;
      rotate: 0deg;
      right: 0;
      font-size: 2.4rem;
      top: 30px;
      translate: none;
    }
  }
</style>
