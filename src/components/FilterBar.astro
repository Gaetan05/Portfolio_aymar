---
/**
 * Client-side filter chips. Items to filter need
 *   data-filter-item  data-filter-keys="key1|key2"
 * inside the element referenced by `target`. Optional wrappers with
 * data-filter-group are hidden when they end up empty.
 */
interface Props {
  target: string;
  options: { key: string; label: string; count?: number }[];
  allLabel?: string;
}
const { target, options, allLabel = 'Everything' } = Astro.props;
---

<div class="filters no-print" data-filter-bar data-target={target} role="toolbar" aria-label="Filter">
  <button type="button" aria-pressed="true" data-key="">{allLabel}</button>
  {
    options.map((o) => (
      <button type="button" aria-pressed="false" data-key={o.key}>
        {o.label}
        {o.count !== undefined && <sup>{o.count}</sup>}
      </button>
    ))
  }
</div>

<script>
  import { gsap, ScrollTrigger } from '../scripts/app';
  document.querySelectorAll<HTMLElement>('[data-filter-bar]').forEach((bar) => {
    const root = document.querySelector(bar.dataset.target!);
    if (!root) return;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];
    const apply = (key: string, animate = true) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.key === key)));
      const shown: HTMLElement[] = [];
      root.querySelectorAll<HTMLElement>('[data-filter-item]').forEach((el) => {
        const keys = (el.dataset.filterKeys ?? '').split('|');
        el.hidden = key !== '' && !keys.includes(key);
        if (!el.hidden) shown.push(el);
      });
      root.querySelectorAll<HTMLElement>('[data-filter-group]').forEach((g) => {
        g.hidden = !g.querySelector('[data-filter-item]:not([hidden])');
      });
      if (animate) gsap.fromTo(shown, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6, stagger: 0.03, ease: 'expo.out', clearProps: 'all' });
      ScrollTrigger.refresh();
      const u = new URL(location.href);
      key ? u.searchParams.set('filter', key) : u.searchParams.delete('filter');
      history.replaceState(null, '', u);
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.key!)));
    const initial = new URL(location.href).searchParams.get('filter');
    if (initial && buttons.some((b) => b.dataset.key === initial)) apply(initial, false);
  });
</script>
