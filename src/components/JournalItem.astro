---
import type { CollectionEntry } from 'astro:content';
import { url, formatDate, kindLabel, readingTime } from '../lib/content';

interface Props {
  entry: CollectionEntry<'journal'>;
}
const { entry } = Astro.props;
const { title, description, date, kind, tags } = entry.data;
---

<li class="item reveal" data-filter-item data-filter-keys={[kind, ...tags].join('|')}>
  <a href={url(`journal/${entry.id}`)}>
    <time class="meta" datetime={date.toISOString()}>{formatDate(date)}</time>
    <div class="main">
      <span class:list={['chip', 'kind', kind]}>{kindLabel[kind]}</span>
      <h3>{title}</h3>
      <p>{description}</p>
    </div>
    <span class="meta rt">{readingTime(entry.body)} min</span>
  </a>
</li>

<style>
  .item {
    list-style: none;
    border-top: 1px solid var(--line);
  }
  a {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: 1.5rem;
    padding: 1.5rem 0.25rem;
    text-decoration: none;
    color: var(--ink);
    align-items: baseline;
    transition: padding 0.25s, background 0.25s;
    border-radius: 12px;
  }
  a:hover {
    color: var(--ink);
    background: var(--bg-elev);
    padding-inline: 1rem;
  }
  a:hover h3 {
    color: var(--accent);
  }
  h3 {
    margin: 0.45rem 0 0.3rem;
    font-size: 1.35rem;
    transition: color 0.15s;
  }
  p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.97rem;
  }
  .kind.discovery,
  .kind.til {
    background: var(--accent-soft);
    border-color: transparent;
    color: var(--accent);
  }
  @media (max-width: 640px) {
    a {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    .rt {
      display: none;
    }
  }
</style>
